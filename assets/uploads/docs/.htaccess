# ======================================================================
# assets/uploads/docs/ — stockage des documents téléversés depuis l'admin
#
# Aucun accès web direct : les fichiers sont servis exclusivement par le
# contrôleur application/controllers/Documents.php, via l'URL
#   /telechargement/{id}/{nom-du-fichier}
#
# Avantages : les formats bloqués par le .htaccess racine (.docx, .xlsx…)
# restent diffusables, les noms de fichiers ne sont pas énumérables et un
# script déposé par erreur ne peut jamais être exécuté.
# ======================================================================

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

# Ceinture + bretelles : aucun handler de script sur ce dossier
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .cgi .pl .py
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar
</IfModule>
